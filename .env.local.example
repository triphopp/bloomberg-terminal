# ── Bloomberg Terminal — Frontend Environment Variables ───────────────────────
# Copy this file to .env.local

# Required: URL of the Python backend (default shown)
PYTHON_API_URL=http://localhost:8000

# Optional: Alpha Vantage (used directly by some Next.js routes)
ALPHA_VANTAGE_API_KEY=

# Optional: OpenAI (AI SDK — not required for core features)
OPENAI_API_KEY=
