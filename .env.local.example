# ── Bloomberg Terminal — Frontend Environment Variables ───────────────────────
# Copy this file to .env.local

# Required: URL of the Python backend (default shown).
# The stack deliberately avoids the crowded 3000/8000 pair:
#   backend  9317   frontend 9318
# Changing a port means three files: this one, backend/.env (CORS_ORIGINS),
# and whatever starts the servers (BloombergTerminal.exe takes --backend-port /
# --frontend-port; npm scripts read BACKEND_PORT / FRONTEND_PORT).
PYTHON_API_URL=http://localhost:9317

# Optional: extra dev origins allowed to load the dev server (comma-separated),
# e.g. a tunnel or LAN hostname next.config.mjs cannot detect on its own.
DEV_ORIGINS=

# ── Data-vendor keys do NOT go here ───────────────────────────────────────────
# Next.js never calls a vendor directly — every data call goes through the
# Python backend. Put these in backend/.env (see backend/.env.example):
#   FRED_API_KEY          FRED macro / rates / credit
#   FISCAL_AI_API_KEY     Fiscal.ai fundamentals (free trial: 100 companies, 250 calls/day)
#   FISCAL_AI_DAILY_LIMIT local call budget for Fiscal.ai (default 250)
#   ANTHROPIC_API_KEY, BOT_*_TOKEN, BINANCE_API_KEY, …
# A key placed in this file is invisible to the backend and does nothing.

# Optional: Alpha Vantage (used directly by some Next.js routes)
ALPHA_VANTAGE_API_KEY=

# Optional: OpenAI (AI SDK — not required for core features)
OPENAI_API_KEY=
