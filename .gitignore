# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules

# next.js
/.next/
/out/

# production
/build

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env.local
.env
backend/.env

# backend — runtime artifacts
backend/__pycache__/
backend/**/__pycache__/
backend/*.db
backend/*.db-wal
backend/*.db-shm
backend/.sync_state.json
# per-database sync sidecars: last pull/push state + the 3-way merge base
backend/.sync_state_*.json
backend/.sync_base*.json
backend/*.db.bak*
backend/.pytest_cache/
# The same artifacts at the repo root. PORTFOLIO_DB defaults to a path relative
# to the working directory, so starting the backend from anywhere other than
# backend/ silently creates a second database here instead of using the real
# one — ignored so a stray copy of somebody's portfolio can never be committed.
/*.db
/*.db-wal
/*.db-shm
/.sync_state*.json
/.sync_base*.json
backend/analytics/__pycache__/
backend/routers/__pycache__/
**/*.pyc
**/*.pyo

# backend — cached external data + trained models (regenerated at runtime)
backend/*_cache.json
# FRED series cache — rewritten on every backend run, so tracking it turned
# each session into a hundreds-of-lines diff on files nobody reads. The
# backend refetches whatever is missing.
backend/cache/
backend/macro_series.json
backend/credit_series.json
backend/**/*.pkl
backend/**/*.pickle
backend/**/*.joblib

# data — trained models (pickle = RCE risk if tampered)
data/**/*.pkl
data/**/*.pickle
data/**/*.joblib
# derived model params — regenerated on startup from the (ignored) .pkl, so the
# tracked copy was never the one in use: a fresh clone has no .pkl, retrains
# immediately, and overwrites whatever was committed. Float-only diffs that
# nobody can review or merge. Regen: backend startup, or POST the retrain
# endpoint. Kept out: validation.json (walk-forward eval record, manual only).
data/models/regime_v2.json
data/models/thresholds.json
data/models/bc_thresholds.json

# personal memory — session logs, analysis reports, active plans (AI agent audit trail)
memory/sessions/
memory/reports/
memory/plans/

# personal notes / roadmap drafts
todo/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
# Claude Code local settings (may contain tokens from allowed-commands history)
.claude/settings.local.json
.claude/launch.json
.claude/

# Codex tool config
.codex/

# windows launcher
/BloombergTerminal.exe
/logs/
tools/launcher/*.res
