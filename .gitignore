# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules

# next.js
/.next/
/out/

# production
/build

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env.local
.env
backend/.env

# backend — runtime artifacts
backend/__pycache__/
backend/**/__pycache__/
backend/*.db
backend/*.db-wal
backend/*.db-shm
backend/.pytest_cache/
backend/analytics/__pycache__/
backend/routers/__pycache__/
**/*.pyc
**/*.pyo

# backend — cached external data + trained models (regenerated at runtime)
backend/*_cache.json
backend/macro_series.json
backend/credit_series.json
backend/**/*.pkl
backend/**/*.pickle
backend/**/*.joblib

# data — trained models (pickle = RCE risk if tampered)
data/**/*.pkl
data/**/*.pickle
data/**/*.joblib

# personal memory — session logs, analysis reports, active plans (AI agent audit trail)
memory/sessions/
memory/reports/
memory/plans/

# personal notes / roadmap drafts
todo/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
# Claude Code local settings (may contain tokens from allowed-commands history)
.claude/settings.local.json
.claude/launch.json
.claude/

# Codex tool config
.codex/
