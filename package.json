{
  "name": "bloomberg",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:all": "concurrently --names \"BACKEND,FRONTEND,OLLAMA\" --prefix-colors \"cyan,green,magenta\" \"cd backend && $(command -v python3 || command -v python) -m uvicorn main:app --port 8000 --reload\" \"next dev\" \"ollama serve\"",
    "dev:no-ollama": "concurrently --names \"BACKEND,FRONTEND\" --prefix-colors \"cyan,green\" \"cd backend && $(command -v python3 || command -v python) -m uvicorn main:app --port 8000 --reload\" \"next dev\"",
    "build": "next build",
    "start": "next start",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "test:alerts": "node --test lib/alerts/__tests__/*.test.ts",
    "analyze": "ANALYZE=true next build",
    "analyze:server": "ANALYZE=true next build --experimental-build-mode=compile",
    "prepare": "husky"
  },
