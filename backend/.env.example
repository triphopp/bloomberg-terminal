# ── Bloomberg Terminal — Backend Environment Variables ────────────────────────
# Copy this file to .env and fill in your values.
# Only FRED_API_KEY is required for most features to work.

# ── Required ──────────────────────────────────────────────────────────────────
FRED_API_KEY=                     # https://fred.stlouisfed.org/docs/api/api_key.html

# ── Optional: market data fallback ────────────────────────────────────────────
ALPHA_VANTAGE_API_KEY=            # https://www.alphavantage.co/support/#api-key

# ── Optional: EIA petroleum data (TAIL oil balance) ──────────────────────────
# Without a key the public DEMO_KEY is used — 10 calls/hour, enough for the 6h cache.
EIA_API_KEY=                      # https://www.eia.gov/opendata/register.php

# ── Optional: Fiscal.ai fundamentals (free trial: 100 fixed companies, 250 calls/day) ─
# Key: fiscal.ai → Data API → Create API key. Secondary source — cross-check vs SEC XBRL.
FISCAL_AI_API_KEY=                # https://docs.fiscal.ai/docs/guides/free-trial
FISCAL_AI_DAILY_LIMIT=250         # local call budget; keep ≤ your plan's daily limit

# ── Optional: Webull OpenAPI — L2 bid/offer depth, US stocks + ETFs (MKT → STRUCTURE → DEPTH) ─
# Key + secret: Webull Thailand website → OpenAPI → generate. The secret only signs requests on
# this machine. The access token is NOT set here: the DEPTH panel requests it, Webull texts a code,
# you confirm it in the Webull app; it is then stored outside the repo (app-data, or WEBULL_TOKEN_DIR).
# More than 1 level needs the OpenAPI TotalView subscription (separate from the in-app one).
WEBULL_APP_KEY=
WEBULL_APP_SECRET=
# WEBULL_API_HOST=api.webull.co.th            # default = production; test: th-api.uat.webullbroker.com
# WEBULL_TOKEN_DIR=                           # default = this user's app-data folder; never inside the repo
# One SMS confirmation serves every machine: the token is also left, AES-256-GCM encrypted with a key
# derived from WEBULL_APP_SECRET, in <SYNC_DIR>/webull/ (the Google Drive folder the portfolio syncs
# through) and the other machines take it from there. Needs the same KEY + SECRET on every machine.
# WEBULL_TOKEN_SHARE=off                      # keep this machine's token to itself
# WEBULL_STREAM_HOST=                         # live book; default follows WEBULL_API_HOST (data-api.webull.co.th)
# The API does not say when the market-data entitlement ends. Copy the date from the Webull website →
# avatar → Advanced Quotes → OpenAPI ("Nasdaq Basic - Non Display … expires …") and DEPTH counts down to it.
# WEBULL_SUBSCRIPTION_ENDS=2027-10-08         # YYYY-MM-DD
# WEBULL_SCAN_INTERVAL=1800                   # s between checks that put "token / entitlement ends" on the alert strip; 0 = off

# ── Optional: AI features ─────────────────────────────────────────────────────
ANTHROPIC_API_KEY=                # https://console.anthropic.com/
OLLAMA_URL=http://localhost:11434 # local Ollama (llama3.1:8b or gemma2:9b recommended)

# ── Optional: NEWS → ASK (question box in the NEWS view, routers/news_ai.py) ──
# The file is re-read on every question, so a key pasted here works without a restart.
DEEPSEEK_API_KEY=                 # https://platform.deepseek.com/api_keys
# Other providers for ASK (all OpenAI chat-completions compatible). Keys can also be
# saved from the panel: NEWS → ASK → MODEL ▸ (written to this file, never shown again).
# Provider and model are picked in that panel per browser; these are only the defaults.
# OPENAI_API_KEY=                   # https://platform.openai.com/api-keys
# GEMINI_API_KEY=                   # https://aistudio.google.com/apikey
# OPENROUTER_API_KEY=               # https://openrouter.ai/keys
# GROQ_API_KEY=                     # https://console.groq.com/keys
# (Anthropic uses ANTHROPIC_API_KEY above.)
# NEWS_AI_CUSTOM_URL=               # any OpenAI-compatible server, e.g. http://127.0.0.1:11434/v1 (Ollama)
# NEWS_AI_CUSTOM_KEY=               # its key, if it wants one
# NEWS_AI_PROVIDER=deepseek         # default provider: deepseek | openai | anthropic | gemini | openrouter | groq | custom
# NEWS_AI_MODEL=deepseek-chat       # default model of the default provider (deepseek-reasoner = thinks first: slower, costs more)
# NEWS_AI_MAX_TOKENS=8000           # ceiling per model turn
# NEWS_AI_WEB_SEARCH=1              # 0 = terminal data only: no news search, no page reading, no web search
# NEWS_AI_READER=1                  # 0 = never send a URL to Jina Reader (JS pages and PDFs then fail)
# NEWS_AI_TOOL_BUDGET=100000        # characters of tool results one question may put in the model's context, all together
# ASK_SESSIONS_STORE=auto           # where this machine keeps ASK conversations: auto | drive | local | off
#                                   #   drive = <cloud folder>/ask-sessions (the Google Drive folder SYNC_DIR points at, or the one found)
#                                   #   local = app-data folder of this user (Windows: %LOCALAPPDATA%\BloombergTerminal\ask-sessions)
#                                   #   auto  = drive when this machine has the cloud folder, else local;  off = keep nothing
# ASK_SESSIONS_DIR=                 # an explicit folder instead — never one inside the repository (refused)
#                                   # set either from ASK → HISTORY → STORAGE, or: python scripts/ask_sessions.py [drive|local|off|--dir PATH]
# NEWS_AI_READ_ANY_URL=0            # 1 = after reading private data (portfolio, thesis, note) ASK may still open ANY address — off keeps it to links a tool returned or you typed
# General web search for ASK — optional, free tiers. Without a key ASK still searches news
# (Google/Bing RSS) and opens pages; with one it can also find non-news pages (official
# documents, IR pages, statistics). Tavily is tried first.
TAVILY_API_KEY=                   # https://app.tavily.com  (free: 1,000 searches/month)
BRAVE_API_KEY=                    # https://api-dashboard.search.brave.com  (free plan)

# ── Optional: Clippings / Obsidian notes (CLIP view) ──────────────────────────
# Set these to your Obsidian vault paths. Leave blank to disable CLIP view.
CLIPPINGS_DIR=
THESES_DIR=
SOURCES_DIR=
OBSIDIAN_WIKI_DIR=

# ── Optional: Crypto order footprint ──────────────────────────────────────────
BINANCE_API_KEY=                  # read-only key — https://www.binance.com/en/my/settings/api-management

# ── Optional: Social feed (NEWS view) ─────────────────────────────────────────
RSSHUB_URL=https://rsshub.app     # default public instance, or self-host
FACEBOOK_ACCESS_TOKEN=            # only needed for Facebook Graph API feed

# ── Optional: Bank of Thailand (BOT view) ─────────────────────────────────────
# Register at: https://apportal.bot.or.th/
BOT_API_TOKEN=                    # Bond Auction
BOT_IR_TOKEN=                     # Interest Rates
BOT_FX_TOKEN=                     # Exchange Rates (requires manual subscription activation)
BOT_STATS_TOKEN=                  # Statistics

# ── Optional: SEC Thailand ────────────────────────────────────────────────────
# New portal (recommended): https://secopendata.sec.or.th/
SEC2_API_KEY=                     # single key covers Fund v2, Bond v2, One Report v1

# Legacy portal (expires 2026-06-30 — Bond v1 already dead):
# SEC_COMMON_PRIMARY=
# SEC_BOND_PRIMARY=            # Bond v1 is dead; config.py still reads it, so the key stays known
# SEC_FUND_FACTSHEET_PRIMARY=
# SEC_FUND_DAILY_PRIMARY=
# SEC_DIGITAL_ASSET_PRIMARY=
# SEC_ONE_REPORT_PRIMARY=

# ── Optional: CORS origins ────────────────────────────────────────────────────
# Frontend runs on 9318 (see .env.local.example in the repo root).
# CORS_ORIGINS=http://localhost:9318,https://yourdomain.com

# ── Optional: Database path ───────────────────────────────────────────────────
# PORTFOLIO_DB=portfolio.db        # default: portfolio.db in backend/

# ── Optional: Claude model config ────────────────────────────────────────────
# CLAUDE_MODEL=claude-opus-4-5
# CLAUDE_MAX_TOKENS=4096

# ── Portfolio Cloud Sync (PC ↔ MacOS via Google Drive) ───────────────────────
# Local portfolio.db stays the working copy. JSON snapshots are exchanged through
# a shared Google Drive folder so both machines converge. The .db file is NEVER
# placed on the drive (Drive byte-sync + WAL corrupts SQLite) — only JSON crosses.
#
# ZERO-CONFIG: leave everything below unset. The backend auto-detects Google Drive
# ("My Drive") on Windows (any drive letter) + macOS (CloudStorage / ~/Google Drive),
# creates "My Drive/Investment Portfolio", and enables sync automatically.
#
# Override only if needed:
# SYNC_DIR=G:\My Drive\Investment Portfolio   # force an explicit folder (skips auto-detect)
# SYNC_FOLDER_NAME=Investment Portfolio       # subfolder name inside My Drive
# SYNC_ENABLED=false                          # hard-disable even if a drive is found
# SYNC_AUTODETECT=false                       # disable auto-detect (require SYNC_DIR)
# SYNC_DEVICE_ID=                             # blank → auto from hostname (PC / MacBook)
# SYNC_PUSH_INTERVAL=60                        # background push cadence (seconds)

# Op-log sync (backend/sync/oplog.py) — every device edits; replaces the snapshot
# merge above (setting it turns that off). Each device appends its own changes to
# <sync folder>/oplog/<device>/; conflicts go to the header chip's REVIEW.
# Switch it on only when every machine holds the same DB (scripts/adopt_db_copy.py).
# OPLOG_ENABLED=true
# OPLOG_DEVICE_ID=                            # blank → .oplog_device_<db> beside the DB
# OPLOG_INTERVAL=15                           # background round cadence (seconds)
